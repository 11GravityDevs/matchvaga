# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only; never use NEXT_PUBLIC_); required for Stripe webhook to grant credits; bypasses RLS
SUPABASE_SECRET_KEY=

# Site URL (optional; defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# AI (server-only; never use NEXT_PUBLIC_)
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe (server-only; never use NEXT_PUBLIC_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PostHog (client-safe)
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
