# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only; never use NEXT_PUBLIC_); required for Stripe webhook to grant credits; bypasses RLS
SUPABASE_SECRET_KEY=

# Site URL (required in production; no trailing slash)
NEXT_PUBLIC_SITE_URL=

# AI (server-only; never use NEXT_PUBLIC_)
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe (server-only; never use NEXT_PUBLIC_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe (client-safe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Contato (client-safe; exibido em Política, Termos e Footer)
NEXT_PUBLIC_SUPPORT_EMAIL=

# PostHog (client-safe)
# Em produção, configure o host apontando para o proxy, por exemplo:
# NEXT_PUBLIC_POSTHOG_HOST="https://seu-dominio.com/ingest"\

# Em desenvolvimento, use:
# NEXT_PUBLIC_POSTHOG_HOST="http://localhost:3000/ingest"
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
